library(tidyverse)
install.packages("palmerpenguins")
library(palmerpenguins)
penguins
glimpse(penguins)
ggplot(penguins,
aes(x = flipper_length_mm, y = body_mass_g)) +
geom_point()
penguins |>
group_by(species) |>
